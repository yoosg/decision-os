SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 인증 토큰 검증용 JWT 시크릿 — 없으면 로그인 필요한 API가 전부 401 거부됨
SUPABASE_JWT_SECRET=your-jwt-secret
# JSON 배열 형식: ["http://localhost:3000","https://your-domain.com"]
# 배포 시 여기에 실제 웹 도메인(Railway web 서비스 URL)을 반드시 추가
CORS_ORIGINS=["http://localhost:3000"]
# OpenAI — LLM 호출/임베딩용
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# FCM 푸시용 서비스 계정 JSON 전체를 한 줄 문자열로 넣음(없으면 푸시 스킵)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Story 6.1: 실 수집기 설정
# COLLECTOR_MODE: "real"(외부 RSS/HN/GitHub 수집) 또는 "stub"(하드코딩 5건 폴백)
COLLECTOR_MODE=real
# 외부 HTTP 요청 타임아웃(초)
COLLECTOR_TIMEOUT_SECONDS=10.0
# Story 6.2: 의미 클러스터링 & 관련성/세이프티 필터
# CLUSTERING_ENABLED: 안전 롤아웃/긴급 차단 토글(false면 6.1 그대로 pass-through)
CLUSTERING_ENABLED=true
# CLUSTER_SIMILARITY_THRESHOLD: 코사인 유사도 클러스터 병합 임계치(초기값, 튜닝 대상)
CLUSTER_SIMILARITY_THRESHOLD=0.82
# RELEVANCE_MIN_SIMILARITY: 도메인 앵커 유사도 하한(미만이면 off_domain 제외)
RELEVANCE_MIN_SIMILARITY=0.20
# 임베딩 모델은 OPENAI_EMBEDDING_MODEL(text-embedding-3-small) 재사용 — 신규 추가 금지
